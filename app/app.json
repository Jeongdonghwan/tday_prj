{
  "expo": {
    "name": "오늘연애",
    "slug": "todaylove",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app_icon.png",
    "scheme": "todaylove",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.hco.todaylove",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleDisplayName": "오늘연애"
      }
    },
    "android": {
      "package": "com.hco.todaylove",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive_foreground.png",
        "backgroundColor": "#F23B5F"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/app_icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash_icon.png",
          "imageWidth": 220,
          "backgroundColor": "#FFFFFF",
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#F23B5F"
        }
      ],
      [
        "@react-native-seoul/kakao-login",
        {
          "kakaoAppKey": "8ac781d72168f57e5f49ae2e5e78319a",
          "kotlinVersion": "2.1.20"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5941a78b-0da8-4ff9-99ea-15bf51ee4281"
      }
    },
    "owner": "jdh227"
  }
}
