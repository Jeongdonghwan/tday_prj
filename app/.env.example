# 앱 → 서버 API 주소.
# - iOS 시뮬레이터: http://127.0.0.1:5000
# - Android 에뮬레이터: http://10.0.2.2:5000
# - 실기기(Expo Go): http://<PC의 LAN IP>:5000
# 미설정 시 Expo 개발 호스트 IP:5000 으로 추정 폴백 (src/api/client.ts)
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:5000

# 테스트존 웹(Flask) 베이스 URL (미설정 시 API 호스트)
EXPO_PUBLIC_WEB_BASE_URL=http://127.0.0.1:5050

# 카카오 로그인 키는 앱 .env 가 아니라 아래 위치에서 관리 (PRELAUNCH.md 참고):
#  - 네이티브(iOS/Android): app.json 의 @react-native-seoul/kakao-login 플러그인 kakaoAppKey(=네이티브 앱 키)
#  - 웹: 서버가 OAuth 처리 → 서버 .env 의 KAKAO_REST_API_KEY (앱은 키 불필요)
