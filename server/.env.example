# ===== 오늘연애 서버 환경변수 예시 =====
# 실제 값은 .env 로 복사해서 사용 (.env 는 git 에 올리지 않음)

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# DB (로컬: docker compose 의 MariaDB / 운영: 카페24 MariaDB)
# 형식: mysql+pymysql://<user>:<pass>@<host>:<port>/<db>
DATABASE_URL=mysql+pymysql://sseuljeon:sseuljeon@127.0.0.1:3307/sseuljeon

# JWT (자체 발급 토큰)
JWT_SECRET=dev-jwt-secret-change-me
JWT_EXPIRES_DAYS=30

# 개발용 모의 로그인 (키 없이 인증 경로 E2E 테스트). 운영에서는 반드시 false.
DEV_LOGIN_ENABLED=true

# 소셜 로그인 키 (확보 후 채움 — 비어있으면 해당 provider 503 비활성)
KAKAO_REST_API_KEY=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# 관리자 페이지 게이트 토큰 (운영은 강하게)
ADMIN_TOKEN=dev-admin-token

# CORS 허용 오리진 — "*"(전체) 또는 콤마 구분 도메인. 운영은 앱/웹 도메인만.
CORS_ORIGINS=*

# 웹/앱 링크
WEB_BASE_URL=http://127.0.0.1:5050
APP_INSTALL_URL=

# 이미지 업로드 (로컬 디스크). 운영은 nginx 정적 서빙 권장.
UPLOAD_DIR=
UPLOAD_MAX_BYTES=8388608

# AI 선택지 제안 (선택, 없으면 503)
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5

# 검색엔진 사이트 소유확인 (구글 서치콘솔 / 네이버 서치어드바이저에서 발급되는 content 값)
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# ===== 운영(production) 체크 =====
# FLASK_ENV=production 이면 아래가 기본값일 때 서버가 [보안 경고] 로그를 남깁니다:
#   SECRET_KEY / JWT_SECRET / ADMIN_TOKEN 강한 값, DEV_LOGIN_ENABLED=false, CORS_ORIGINS 도메인 제한
